[Unit]
Description=waf-proxy TLS frontend — NGINX/OpenSSL acceleration plane
Documentation=file:/opt/waf-proxy/README.md
After=network-online.target waf-proxy.service
Wants=network-online.target
Requires=waf-proxy.service

[Service]
Type=simple
User=waf
Group=waf
WorkingDirectory=/etc/waf
ExecStart=/usr/local/bin/waf-tlsfront run --control /run/waf-proxy/tls-frontend-live.json --out-dir /run/waf-tls-frontend --poll 250ms
EnvironmentFile=-/etc/waf/waf-tls-frontend.env

# NGINX owns the public 443 listener only when tls_acceleration.mode=frontend.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

Restart=on-failure
RestartSec=2
TimeoutStopSec=30

# Keep the QAT device namespace visible when a host has Intel QAT. Access is
# still constrained by ordinary Unix device permissions and the service user.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
RuntimeDirectory=waf-tls-frontend
RuntimeDirectoryMode=0750
ReadOnlyPaths=/etc/waf

[Install]
WantedBy=multi-user.target
