#!/bin/sh
set -eu
case "${1:-}" in
  remove|deconfigure)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl stop waf-tls-frontend.service >/dev/null 2>&1 || true
      systemctl stop waf-proxy.service >/dev/null 2>&1 || true
    fi
    ;;
  upgrade|failed-upgrade)
    # Keep the currently running process alive while dpkg replaces files.
    # postinst restarts only services that are still active.
    ;;
esac
exit 0
