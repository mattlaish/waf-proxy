{
  "rules": "/etc/waf/coraza.conf",
  "engine_mode": "DetectionOnly",
  "read_timeout_sec": 15,
  "idle_timeout_sec": 60,
  "backend_timeout_sec": 30,
  "passive_discovery_enabled": true,
  "trusted_proxy_cidrs": [],
  "tls_acceleration": {
    "mode": "go",
    "ktls": "off",
    "qat": "off",
    "worker_processes": 0,
    "worker_connections": 4096,
    "http2": true
  },
  "vector_acceleration": {
    "mode": "off",
    "state_path": "/var/lib/waf-proxy/vector-learning.json",
    "min_samples": 100000,
    "min_coraza_matches": 10,
    "min_learning_sec": 3600,
    "verification_sample_rate": 0.01
  },
  "security": {
    "enabled": false,
    "rate_per_second": 0,
    "rate_burst": 0,
    "max_inflight_per_ip": 0,
    "max_connections_per_ip": 0,
    "tls_handshakes_per_minute": 0,
    "tls_handshake_burst": 0,
    "allow_cidrs": [],
    "deny_cidrs": [],
    "block_status": 403,
    "block_page": "",
    "state_path": "/var/lib/waf-proxy/security-state.json"
  },
  "nodes": [
    {
      "name": "app1",
      "host": "127.0.0.1"
    }
  ],
  "pools": [
    {
      "name": "default-pool",
      "scheme": "http",
      "lb_method": "round_robin",
      "backend_tls": {},
      "monitor": {
        "type": "tcp",
        "interval_sec": 5,
        "timeout_sec": 2,
        "rise": 2,
        "fall": 3
      },
      "members": [
        {
          "node": "app1",
          "port": 8080,
          "weight": 1
        }
      ],
      "transport": {
        "max_idle_conns": 2048,
        "max_idle_conns_per_host": 256,
        "max_conns_per_host": 0,
        "idle_conn_timeout_sec": 90,
        "dial_timeout_sec": 5,
        "keep_alive_sec": 30
      }
    },
    {
      "name": "secure-backend-example",
      "scheme": "https",
      "lb_method": "round_robin",
      "backend_tls": {
        "use_system_ca": true,
        "ca_files": [
          "/etc/waf/pki/company-root.pem"
        ],
        "crl_files": [
          "/etc/waf/pki/company-root.crl"
        ],
        "server_name": "app.internal.example",
        "revocation_mode": "hard",
        "crl_urls": [],
        "refresh_sec": 3600
      },
      "monitor": {
        "type": "https",
        "path": "/healthz",
        "expect_status": 200,
        "interval_sec": 5,
        "timeout_sec": 2,
        "rise": 2,
        "fall": 3
      },
      "members": [
        {
          "node": "app1",
          "port": 8443,
          "weight": 1
        }
      ],
      "transport": {
        "max_idle_conns": 2048,
        "max_idle_conns_per_host": 256,
        "max_conns_per_host": 0,
        "idle_conn_timeout_sec": 90,
        "dial_timeout_sec": 5,
        "keep_alive_sec": 30
      }
    }
  ],
  "policies": [
    {
      "name": "default",
      "rules_path": "/etc/waf/coraza.conf",
      "paranoia_level": 1,
      "request_body_limit": 0,
      "exclusions": [],
      "response_body_inspection": "on",
      "response_body_limit": 1048576
    }
  ],
  "sites": [
    {
      "name": "default",
      "listen": ":8443",
      "hostnames": [
        "*"
      ],
      "pool": "default-pool",
      "policy": "default",
      "preserve_host": true,
      "manage_ip": false,
      "manage_interface": "",
      "manage_prefix_len": 0,
      "engine_mode": "",
      "ai_mode": "off",
      "tls_cert": "",
      "tls_key": "",
      "page_policies": []
    }
  ],
  "users": [],
  "ai": {
    "enabled": false,
    "provider": "openai",
    "base_url": "https://api.openai.com/v1",
    "api_key": "",
    "model": "gpt-4o-mini",
    "timeout_sec": 8,
    "max_tokens": 300,
    "only_on_match": true,
    "sample_rate": 0,
    "include_body": false,
    "redact_headers": true,
    "hash_client_ip": false,
    "block_threshold": 85,
    "block_ttl_sec": 900,
    "workers": 2,
    "queue_size": 512
  },
  "notify": {
    "webhook_url": "",
    "webhook_kind": "slack",
    "on_suggestion": true,
    "on_ai_block": true,
    "on_member_down": true,
    "on_sync": true,
    "on_peer": true
  },
  "ha": {
    "enabled": false,
    "role": "primary",
    "peer_url": "",
    "peer_token": "",
    "sync_config": true
  },
  "syslog": {
    "enabled": false,
    "host": "",
    "port": 6514,
    "protocol": "tls",
    "format": "rfc5424",
    "facility": 16,
    "app_name": "waf-proxy",
    "tls_skip_verify": false,
    "send_waf": true,
    "send_access": false,
    "send_audit": true,
    "send_notify": true,
    "include_match_data": false
  }
}
